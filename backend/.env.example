# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=5000
HOST=localhost

# ================================
# MongoDB Configuration
# ================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/complaint_system

# MongoDB Atlas (Production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/complaint_system?retryWrites=true&w=majority

DB_NAME=complaint_system

# ================================
# JWT Configuration
# ================================
# IMPORTANT: Generate secure random strings for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_ISSUER=complaint-resolution-system
JWT_AUDIENCE=complaint-resolution-users

# ================================
# Frontend URL (for CORS & emails)
# ================================
# Development
FRONTEND_URL=http://localhost:5173

# Production
# FRONTEND_URL=https://your-domain.com

# ================================
# Cloudinary Configuration (File Uploads)
# ================================
# Sign up at https://cloudinary.com/ for free account
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ================================
# Email Configuration (SMTP)
# ================================
# Gmail Configuration (use App Password, not regular password)
# Enable 2FA and create App Password at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Other SMTP providers:
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
# Amazon SES: email-smtp.us-east-1.amazonaws.com, port 587

EMAIL_FROM_NAME=Complaint Resolution System
EMAIL_FROM_ADDRESS=noreply@complaint-system.com

# ================================
# AI Assignment (Optional)
# ================================
# Enables model-assisted assignment ranking with automatic local fallback.
ASSIGNMENT_AI_ENABLED=false
ASSIGNMENT_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key

# ================================
# Admin Setup (First Admin Registration)
# ================================
# This key is required to create the first admin account
# Change this to a secure random string
ADMIN_SETUP_KEY=your-secret-admin-setup-key-change-this

# ================================
# Rate Limiting
# ================================
# Applied in production. In development, limiters are skipped.
API_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX=100

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX=3

UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=10

COMPLAINT_RATE_LIMIT_WINDOW_MS=3600000
COMPLAINT_RATE_LIMIT_MAX=5

AUTH_API_RATE_LIMIT_WINDOW_MS=60000
AUTH_API_RATE_LIMIT_MAX=30

PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_API_RATE_LIMIT_MAX=20

# ================================
# Scheduler Configuration
# ================================
ENABLE_SCHEDULER=true

# Cron expressions (https://crontab.guru/)
ESCALATION_CRON=0 * * * *
WARNING_CRON=*/30 * * * *
DAILY_SUMMARY_CRON=0 9 * * *

# Escalation settings
WARNING_THRESHOLD_HOURS=4
MAX_ESCALATION_LEVEL=3
RE_ESCALATION_HOURS=24
WARNING_COOLDOWN_HOURS=2
SCHEDULER_TIMEZONE=UTC

# ================================
# Logging
# ================================
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ================================
# API Keys (for external integrations)
# ================================
# Comma-separated list of valid API keys
API_KEYS=key1,key2,key3

# ================================
# Timezone
# ================================
TZ=UTC

# ================================
# Optional: Redis (for caching/sessions)
# ================================
# REDIS_URL=redis://localhost:6379

# ================================
# Optional: Sentry (for error tracking)
# ================================
# SENTRY_DSN=https://your-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=0.1

# ================================
# Session / CSRF
# ================================
SESSION_SECRET=replace-with-a-long-random-session-secret